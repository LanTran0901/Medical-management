[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
fastapi = "*"
uvicorn = {extras = ["standard"], version = "*"}
motor = "*"
pydantic-settings = "*"
sqlalchemy = {extras = ["asyncio"], version = "*"}
asyncpg = "*"
greenlet = "*"
alembic = "*"
psycopg2-binary = "*"
langgraph = "*"
langchain-groq = "*"
pgvector = "*"
fastembed = "*"
pyjwt = "*"
passlib = {extras = ["bcrypt"], version = "*"}
bcrypt = "<4.0.0"
python-multipart = "*"
google-auth = "*"
requests = "*"
firebase-admin = "*"
python-dateutil = "*"
tzdata = "*"

[dev-packages]

[requires]
python_version = "3.12"

[scripts]
start = "uvicorn app.main:app --host 0.0.0.0 --port 7543 --reload"
# Một lần chạy: Alembic upgrade + pytest tests/ (unit + integration). Cần Postgres khi integration bật.
test-all = "python scripts/run_all_tests.py"
