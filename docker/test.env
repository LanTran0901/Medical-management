# Dùng với docker-compose.test.yml (pytest + PostgreSQL trong Docker).
# MongoDB không cần — SKIP_MONGO_LIFESPAN=1 trong compose.
#
# Chạy pytest trên máy host với .env trỏ Supabase: xem tests/integration/conftest.py
# (mặc định ghi đè DATABASE_URL → localhost/medical, hoặc INTEGRATION_DATABASE_URL).

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medical
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Image postgres:alpine thường không bật SSL nội bộ
POSTGRES_SSLMODE=disable

# Bắt buộc theo app.core.config (không dùng khi SKIP_MONGO_LIFESPAN=1)
MONGODB_URI=mongodb://127.0.0.1:27017/dummy

GROQ_API_KEY=test-docker-placeholder
GROQ_MODEL=llama-3.1-8b-instant

JWT_SECRET=test-docker-jwt-secret-change-in-ci
BCRYPT_ROUNDS=4
# Long TTL so integration tests are not flaky by wall-clock expiry
FAMILY_PUBLIC_INVITE_TTL_SECONDS=604800
FIREBASE_CREDENTIALS_PATH=
EXPO_PUSH_ENABLED=0
SCHEDULE_DISPATCH_ENABLED=0
