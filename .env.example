APP_NAME="Medical Management API"

# ─── MongoDB (document store) ────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority&appName=<app-name>"
# Optional: override db name parsed from MONGODB_URI
MONGODB_DB_NAME=""

# ─── PostgreSQL (relational store) ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medical
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSLMODE=require

# Medical record attachments — local disk (MVP); path relative to process cwd or absolute
MEDICAL_UPLOAD_DIR=uploads/medical
MEDICAL_UPLOAD_MAX_MB=10

# Public family QR/deep-link invite codes (single-use + expiry); seconds, default 24h
FAMILY_PUBLIC_INVITE_TTL_SECONDS=86400

# Firebase Admin (FCM). Path to service account JSON; required for push + optional schedule dispatch.
# FIREBASE_CREDENTIALS_PATH=

# Poll ACTIVE MEDICINE schedules and send FCM at remind_time (UTC minute match).
# SCHEDULE_DISPATCH_ENABLED=false
# SCHEDULE_DISPATCH_INTERVAL_SECONDS=60
# FCM_ANDROID_CHANNEL_SCHEDULE=medicine_reminders
# Manual/cron: POST /notifications/dispatch/schedules with header X-Internal-Secret
# INTERNAL_DISPATCH_SECRET=

GROQ_API_KEY="gsk_xxx"
GROQ_MODEL="llama-3.1-8b-instant"
RAG_CHAT_HISTORY_COLLECTION="rag_chat_history"
RAG_EMBEDDING_MODEL="intfloat/multilingual-e5-small"
RAG_EMBEDDING_DIMENSIONS=384
RAG_TOP_K=6
RAG_PER_TYPE_LIMIT=3
